    #endregion

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// Calls the NEWS API, 
    /// deserializes the JSON response using NewsApiResponse, Article and Source classes, and writes the data of each Article into the SSIS output buffer.
    /// </summary>
    /// <remarks>
    /// The method populates rows for the RAWnews staging table.
    /// </remarks>
    /// <exception cref="Exception">
    /// Thrown when the API request or JSON deserialization fails.
    /// </exception>
    public override void CreateNewOutputRows()
    {
        System.Net.ServicePointManager.SecurityProtocol = System.Net.SecurityProtocolType.Tls12;
        HttpClient client = new HttpClient();
        client.DefaultRequestHeaders.Add("User-Agent", "My_SSIS_News_Project/1.0");

        JavaScriptSerializer serializer = new JavaScriptSerializer();
        DateTime apiFetchedAt = DateTime.Now;
        bool processedFlag = false;

        //API shared structure
        string apiKey = Variables.NewsApiKey.ToString();
        string baseUrl = "https://newsapi.org/v2/everything?sortBy=relevancy&language=en&pageSize=30&page=1&apiKey=" + apiKey;


        // topics for api queries
        string[] newsTopics = new string[]
        {
             "geopolitics OR war OR conflict",
             "sanctions OR election OR government policy",
             "diplomacy OR political crisis OR regime OR international relations",
             "economy OR economic growth OR GDP",
             "inflation OR CPI OR recession",
             "currency OR forex OR exchange rate OR stock market OR bond yield OR financial markets OR trade OR investment",
             "central bank OR interest rate OR rate hike OR rate cut",
             "Fed OR ECB OR monetary policy OR liquidity OR quantitative easing",
             "treasury yield OR fiscal policy OR market sentiment"
        };

        // The API is called once for each topic in each time window.
        // 9 topics are queried across 4 non-overlapping time windows,
        // resulting in 36 API requests in total.
        DateTime start = apiFetchedAt.AddDays(-30);

        //list for the unique url-s to skip any news already in the pipeline.
        List<string> urlsForDuplicateProtection = new List<string>();

        while (start < apiFetchedAt)
        {
            DateTime end = start.AddDays(7);

            if (end > apiFetchedAt)
                end = apiFetchedAt;

            
            // API hívás start -> end
            foreach (string topic in newsTopics)
            {
                try
                {
                    string finalUrl = $"{baseUrl}&q={Uri.EscapeDataString(topic)}&from={start:yyyy-MM-dd}&to={end:yyyy-MM-dd}";

                    string logUrl = finalUrl.Replace(apiKey, "***API_KEY***");

                    bool fireAgain = false;
                    ComponentMetaData.FireInformation(
                        0,
                        "News API Request",
                        $"API kérés: {logUrl}",
                        "",
                        0,
                        ref fireAgain
                    );

                    var response = client.GetStringAsync(finalUrl).Result;
                    NewsApiResponse result = serializer.Deserialize<NewsApiResponse>(response);


                    if (result != null && result.status == "ok" && result.articles != null)
                    {
                        foreach (var article in result.articles)
                        {
                            if (article == null)
                                continue;

                            if (string.IsNullOrWhiteSpace(article.url))
                                continue;

                            if (urlsForDuplicateProtection.Contains(article.url))
                                continue;

                            urlsForDuplicateProtection.Add(article.url);
                            
                            NewsOutputBuffer.AddRow();

                            NewsOutputBuffer.Sourceid = article.source?.id ?? "";
                            NewsOutputBuffer.Sourcename = article.source?.name ?? "";

                            NewsOutputBuffer.Content = article.content ?? "";
                            NewsOutputBuffer.Url = article.url ?? "";
                            NewsOutputBuffer.Description = article.description ?? "";
                            NewsOutputBuffer.Title = article.title ?? "";
                            NewsOutputBuffer.Author = article.author ?? "";
                            NewsOutputBuffer.UrlToImage = article.urlToImage ?? "";

                            DateTime pubDate;
                            if (article.publishedAt != null && DateTime.TryParse(article.publishedAt, out pubDate))
                            {
                                NewsOutputBuffer.PublishedAt = pubDate;
                            }
                            else
                            {
                                NewsOutputBuffer.PublishedAt_IsNull = true;
                            }

                            NewsOutputBuffer.APIFetchedAt = apiFetchedAt;
                            NewsOutputBuffer.ProcessedFlag = processedFlag;
                        }
                    }
                    
                }
                catch (Exception e)
                {
                    string realError = e.InnerException != null ? e.InnerException.Message : e.Message;

                    ComponentMetaData.FireWarning(0, "News API", $"Hiba a '{topic}' feldolgozásakor: {realError}", "", 0);
                }
                System.Threading.Thread.Sleep(2000);
            }

            start = end.AddDays(1);
        }

        
    }

}
    ]]></arrayElement>
